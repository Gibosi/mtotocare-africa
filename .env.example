# Copy this file to .env and fill in your real values.
# NFR-075: secrets must never be committed to source control.

# Database (NFR-038)
DB_USERNAME=mtotocare
DB_PASSWORD=change-me-to-a-strong-password
MYSQL_ROOT_PASSWORD=change-me-too

# JWT — must be 64+ random characters
# Generate one with: openssl rand -base64 64
JWT_SECRET=change-me-to-a-64-char-random-string-aaaaaaaaaaaaaaaaa

# Email (NFR for transactional emails)
GMAIL_USER=your.email@gmail.com
GMAIL_APP_PASSWORD=xxxxxxxxxxxxxxxx

# AI
GROQ_API_KEY=

# Frontend
APP_BASE_URL=http://localhost:8080

# Rate limiting (NFR-002/NFR-003)
RATE_LIMIT_ANON_RPM=60
RATE_LIMIT_AUTH_RPM=600
